package-as: GlobalPlayed

ignore:
  - .git
  - .gitignore
  - .github
  - .vscode
  - README.md
  - CHANGELOG.md
  - LICENSE
  - scripts/
  - tests/

enable-toc-libraries: false

externals:
  libs/LibStub:
    url: https://repos.wowace.com/wow/libstub/trunk
    tag: latest
  libs/CallbackHandler-1.0:
    url: https://repos.wowace.com/wow/callbackhandler-1-0/trunk
    tag: latest
  libs/LibDataBroker-1.1:
    url: https://repos.wowace.com/wow/libdatabroker-1-1/trunk
    tag: latest
  libs/Ace3:
    url: https://repos.curseforge.com/wow/ace3/trunk
    tag: latest

required-dependencies:
  - LibStub
  - CallbackHandler-1.0
  - LibDataBroker-1.1

optional-dependencies:
  - Ace3

embedded-libraries:
  - LibStub
  - CallbackHandler-1.0
  - LibDataBroker-1.1

tools-used:
  - packager
  - curseforge
  - wago.io
  - wowinterface

manual-changelog: 
  filename: CHANGELOG.md
  markup-type: markdown

tags:
  use-project-version: true

enable-nolib-creation: yes

relations:
  curseforge:
    id: 377190
  wago:
    id: QNlqm46e
  wowinterface:
    id: 26910
